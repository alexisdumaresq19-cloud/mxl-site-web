# Copiez ce fichier en .env.local (en local) ou ajoutez ces variables dans
# Vercel > Settings > Environment Variables. Ne committez jamais les vraies valeurs.

# Jeton personnel ForgeUI Pro, pour installer les blocs Pro (https://forgeui.in/docs/cli).
FORGEUI_API_TOKEN=

# Formulaire de contact : envoi des demandes par courriel via Resend (https://resend.com).
RESEND_API_KEY=
# Adresse qui reçoit les demandes d'estimation.
CONTACT_TO_EMAIL=
# Expéditeur (domaine vérifié dans Resend). Facultatif.
CONTACT_FROM_EMAIL=
